<?xml version="1.0"?>
<!-- Simülasyon için basit forklift gövdesi: iki tahrik tekeri, bir sarhoş teker, 2D LiDAR.
     Ölçüler teknik sunumdaki taslağa yakındır; çatal ve kaldırma henüz yok.
     base_link'in orijini iki tahrik tekerinin ortasında (robot bu noktanın etrafında döner);
     gövde 0,2 m arkaya, 0,6 m öne uzanır. Navigasyondaki footprint ve LiDAR TF'i buna göre. -->
<sdf version="1.9">
  <model name="forklift">

    <link name="base_link">
      <!-- gövde: 0,80 x 0,45 x 0,15 m, yerden 7 cm yüksekte -->
      <inertial>
        <pose>0.20 0 0.145 0 0 0</pose>
        <mass>12.0</mass>
        <inertia><ixx>0.225</ixx><iyy>0.6625</iyy><izz>0.8425</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="govde">
        <pose>0.20 0 0.145 0 0 0</pose>
        <geometry><box><size>0.80 0.45 0.15</size></box></geometry>
      </collision>
      <visual name="govde">
        <pose>0.20 0 0.145 0 0 0</pose>
        <geometry><box><size>0.80 0.45 0.15</size></box></geometry>
        <material><ambient>0.95 0.6 0.1 1</ambient><diffuse>0.95 0.6 0.1 1</diffuse></material>
      </visual>
      <!-- önü gösteren koyu şerit (robotun yönünü görmek için) -->
      <visual name="on_isareti">
        <pose>0.56 0 0.221 0 0 0</pose>
        <geometry><box><size>0.08 0.45 0.004</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- sarhoş teker: sürtünmesiz küre -->
      <collision name="sarhos_teker">
        <pose>0.50 0 0.05 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <visual name="sarhos_teker">
        <pose>0.50 0 0.05 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>

      <!-- LiDAR gövdesi (görsel) -->
      <visual name="lidar_govde">
        <pose>0.45 0 0.25 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- 2D LiDAR: 12 m, 10 Hz (RPLIDAR A1 benzeri). Tam 360 derece yerine 355 derece
           taranır: slam_toolbox tam tur taramalarda ölçüm sayısını yanlış hesaplayabiliyor. -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.45 0 0.27 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>356</samples>
              <resolution>1</resolution>
              <min_angle>-3.1</min_angle>
              <max_angle>3.1</max_angle>
            </horizontal>
          </scan>
          <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </link>

    <link name="sol_teker">
      <pose>0 0.225 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.000379</ixx><iyy>0.000379</iyy><izz>0.000625</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="sag_teker">
      <pose>0 -0.225 0.05 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.000379</ixx><iyy>0.000379</iyy><izz>0.000625</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="sol_teker_eklem" type="revolute">
      <parent>base_link</parent>
      <child>sol_teker</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="sag_teker_eklem" type="revolute">
      <parent>base_link</parent>
      <child>sag_teker</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Hız komutu (/cmd_vel) ile sürüş ve teker dönüşünden konum (/odom) -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>sol_teker_eklem</left_joint>
      <right_joint>sag_teker_eklem</right_joint>
      <wheel_separation>0.45</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
    </plugin>

  </model>
</sdf>
